# Copy this file to .env.local for local runs, and add the same values in Vercel › Project › Settings › Environment Variables.

# Supabase › Project Settings › API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret: server only. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Shopify admin › Settings › Notifications › Webhooks (the signing secret shown under the webhook list)
SHOPIFY_WEBHOOK_SECRET=

# Optional
NEXT_PUBLIC_DESK_PHONE=
# true = riders must enter the customer's SMS code on delivery (needs an SMS provider). Leave false for now.
NEXT_PUBLIC_REQUIRE_OTP=false
# true = show demo helpers (customer code hint, distance slider). Keep false when live.
NEXT_PUBLIC_DEMO=false
